# Copy to .env for local development. .env is gitignored; this file is not.
#
# EVERYTHING HERE IS OPTIONAL. With none of it set, the app runs against a local
# libSQL file with no authentication — which is how development and the whole
# test suite run.

# --- database -----------------------------------------------------------------
# Unset: a plain local libSQL file at DB_PATH.
# Set:   that file becomes an embedded replica synced from Turso.
# TURSO_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# DB_PATH=./data/alfred.db

# --- auth ---------------------------------------------------------------------
# Unset: no login. Every request is the lowest-id user — the `owner` the
#        migration creates. This is how development and the whole test suite run.
# =1:    every request needs a valid session cookie.
#
# The server REFUSES TO START with NODE_ENV=production and this unset.
#
# Careful setting it locally: Bun auto-loads .env for the server the browser
# suite spawns, so a stray value here would make every test fail on a 401, for a
# reason nowhere near the failure. The e2e fixture sets it explicitly either way.
# AUTH_REQUIRED=1
#
# Accounts are created with:  bun run user:add <username>   (password on stdin)
# There is no signup page. The same command sets an existing user's password,
# which also invalidates their existing sessions.

# PORT=3000

{
  "name": "alfred",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "start": "bun src/server/index.ts",
    "test": "bun test tests/",
    "e2e": "playwright test --project=mobile --project=desktop",
    "e2e:all": "playwright test",
    "e2e:docker": "docker build -q -f Dockerfile.test -t alfred-test . && docker run --rm -v \"$PWD\":/app -v alfred-test-nm:/app/node_modules -w /app alfred-test sh -c \"bun install --frozen-lockfile >/dev/null && bunx playwright test --project=mobile-webkit --project=desktop-webkit\"",
    "e2e:ui": "playwright test --ui --project=mobile --project=desktop",
    "e2e:report": "playwright show-report e2e-report",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "user:add": "bun src/server/user-cli.ts add",
    "user:invite": "bun src/server/user-cli.ts invite",
    "user:disable": "bun src/server/user-cli.ts disable",
    "user:enable": "bun src/server/user-cli.ts enable"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.44.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.9.0"
  }
}

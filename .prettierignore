# Markdown is written by hand, not laid out by a tool. Prettier reflows the
# tables and the prose in README.md and .plan/ for no gain — 226 lines of churn
# that make the docs harder to read, not easier.
*.md

# Same reason, smaller: the comments in ci.yml are aligned into a column on
# purpose, and Prettier pulls every one of them back to a single space.
.github/

# Generated by drizzle-kit, which owns the formatting of everything in here.
# 0003 is hand-written SQL besides.
drizzle/

# Stray Bun build output — not source, and not referenced by anything. Listed
# so `bun run format` cannot walk into 1.2 MB of built JS. The real fix is to
# delete the directory.
undefined/

# Not ours, or not source.
node_modules/
data/
e2e-report/
test-results/
bun.lock
